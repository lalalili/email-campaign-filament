{
    "name": "lalalili/email-campaign-filament",
    "description": "Filament admin UI layer for the email-campaign package.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "lalalili/audience-core": "^0.1.1",
        "lalalili/email-campaign": "^0.1.1",
        "lalalili/survey-core": "^0.1.1",
        "filament/filament": "^4.0|^5.0",
        "filament/forms": "^4.0|^5.0",
        "filament/schemas": "^4.0|^5.0",
        "filament/tables": "^4.0|^5.0",
        "filament/actions": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "pestphp/pest-plugin-livewire": "^3.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "~2.2.0",
        "lalalili/package-testing-support": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/audience-core.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/email-campaign.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/survey-core.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/lalalili/package-testing-support.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "Lalalili\\EmailCampaignFilament\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lalalili\\EmailCampaignFilament\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lalalili\\EmailCampaignFilament\\EmailCampaignFilamentServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.2.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress",
        "format": "pint"
    }
}
